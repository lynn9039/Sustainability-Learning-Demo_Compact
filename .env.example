# Copy to `.env` or `.env.local` for local `vercel dev`.
# Never commit real values — `.env`, `.env.local`, and `.env.*` are gitignored (except this file).

# Anthropic Messages API
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-4-5-20250929.
ANTHROPIC_MODEL=
# compact is optimized for Vercel Hobby; full is richer for self-hosting.
GENERATION_MODE=compact

# Cloudflare Turnstile — backend verification only.
# Site key is public: hardcode it in public/index.html (data-sitekey), not here.
TURNSTILE_SECRET_KEY=

# Vercel KV / Upstash Redis REST (auto-injected on Vercel when KV is linked)
KV_REST_API_URL=
KV_REST_API_TOKEN=
